{
  "name": "clipforge-ai",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && tsc -p tsconfig.worker.json && tsc -p tsconfig.container.json",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:worker": "vitest run --config vitest.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "firebase": "^11.10.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.147.0"
  }
}
