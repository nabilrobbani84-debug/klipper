# Automatic HTTPS via Let's Encrypt. DOMAIN is injected from the environment.
{$DOMAIN} {
	encode zstd gzip

	# Allow large uploads/streamed media.
	request_body {
		max_size 50MB
	}

	# Media streaming + API + SPA are all served by the app container.
	reverse_proxy app:8080 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
