# ============================================================================
# ClipForge AI — local configuration (Cloudflare stack)
# NEVER commit real secrets. Only VITE_* values reach the browser.
#
#   .env       → Vite frontend (copy the VITE_* lines)
#   .dev.vars  → `wrangler dev` Worker secrets (copy the Worker lines)
# Non-secret Worker settings live in wrangler.jsonc ("vars").
# ============================================================================

# --- Frontend (build-time, public) ------------------------------------------
# Empty = same origin. In dev the Vite proxy forwards /api and /media to wrangler dev (:8787).
VITE_API_URL=
# Optional Google sign-in (public Firebase web config — safe to expose).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# --- Worker secrets (.dev.vars locally, `wrangler secret put` in production) -
# Required. Generate with: openssl rand -base64 48
AUTH_SECRET=change-this-development-secret-to-at-least-32-characters
# Optional: Gemini for clip detection. Without it Workers AI (Llama 3.3) is used.
GEMINI_API_KEY=
# Optional: Netscape-format cookies.txt content to reduce YouTube bot checks.
YTDLP_COOKIES=

# --- Worker vars you may override (defaults in wrangler.jsonc) --------------
# ADMIN_EMAILS=you@example.com
# FIREBASE_PROJECT_ID=your-firebase-project
# ALLOW_REGISTRATION=true
