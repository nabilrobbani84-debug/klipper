# Server Configuration
PORT=3000
NODE_ENV=production
APP_URL=https://clipforge.ai

# Database (PostgreSQL / Cloud SQL)
DATABASE_URL=postgresql://clipforge:secure_password@localhost:5432/clipforge_db

# Job Queue & Cache (Redis)
REDIS_URL=redis://localhost:6379

# Object Storage (S3 / Cloudflare R2 / Google Cloud Storage)
STORAGE_ENDPOINT=
STORAGE_BUCKET=clipforge-media-bucket
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_SIGNING_KEY=clipforge-production-signing-secret-2026
CDN_URL=https://cdn.clipforge.ai

# AI Engine (Google Gemini API)
GEMINI_API_KEY=

# Security & Authentication
AUTH_SECRET=clipforge-super-secret-auth-key-2026
SESSION_MAX_AGE_DAYS=14
RATE_LIMIT_MAX_PER_MINUTE=80
