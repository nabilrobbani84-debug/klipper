# Frontend: public API origin only. Never put private provider secrets in VITE_* variables.
VITE_API_URL=http://localhost:8080
VITE_DEV_USER_ID=local-development-user

# API/worker runtime
APP_URL=http://localhost:8080
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://clipforge:clipforge@localhost:5432/clipforge
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000
AUTH_SECRET=change-this-development-secret-to-at-least-32-characters
ALLOW_DEV_AUTH=true

# Media/AI providers (worker only)
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
WHISPER_BIN=whisper
GEMINI_API_KEY=
MAX_VIDEO_DURATION_SECONDS=7200
JOB_CONCURRENCY=2
STORAGE_DIR=./.runtime/storage
TEMP_DIR=./.runtime/tmp
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
TEMP_RETENTION_HOURS=24
SOURCE_RETENTION_DAYS=30
EXPORT_RETENTION_DAYS=90
LOG_LEVEL=info

# Production object storage / payments / monitoring (required when those adapters are enabled)
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
SENTRY_DSN=
