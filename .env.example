# ============================================================================
# ClipForge AI — environment configuration
# Copy to `.env` and fill in. NEVER commit real secrets.
# Only VITE_* values reach the browser; keep every provider secret server-side.
# ============================================================================

# --- Frontend (build-time, public) ------------------------------------------
# Leave VITE_API_URL empty for same-origin production (the API serves the SPA).
# In local dev the Vite proxy forwards /api and /media to the API, so empty is fine.
VITE_API_URL=
# Optional: dev-only auto-login (requires ALLOW_DEV_AUTH=true on the API).
VITE_DEV_USER_ID=
VITE_DEV_ROLE=
# Optional: Google sign-in (public Firebase web config — safe to expose).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# --- Core API / worker runtime ----------------------------------------------
APP_URL=http://localhost:8080
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://clipforge:clipforge@localhost:5432/clipforge
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000
# Generate with: openssl rand -base64 48
AUTH_SECRET=change-this-development-secret-to-at-least-32-characters
SESSION_TTL_HOURS=336
TRUST_PROXY=1
# Dev-only fixed identity. MUST be false in production.
ALLOW_DEV_AUTH=true
ALLOW_REGISTRATION=true
# Comma-separated emails auto-promoted to admin on login.
ADMIN_EMAILS=
# Optional token to expose /metrics in production (Bearer).
METRICS_TOKEN=

# --- Storage: Cloudflare R2 (S3-compatible) ---------------------------------
# Local disk for development; set STORAGE_DRIVER=s3 for R2 in production.
STORAGE_DRIVER=local
STORAGE_DIR=./.runtime/storage
TEMP_DIR=./.runtime/tmp
# Cloudflare R2 (STORAGE_DRIVER=s3):
#   STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   STORAGE_REGION=auto
#   STORAGE_BUCKET=clipforge
#   STORAGE_ACCESS_KEY=<R2 Access Key ID>
#   STORAGE_SECRET_KEY=<R2 Secret Access Key>
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Signed media URL lifetime (seconds).
MEDIA_URL_TTL_SECONDS=21600
# Retention windows for the cleanup job.
TEMP_RETENTION_HOURS=24
SOURCE_RETENTION_DAYS=30
EXPORT_RETENTION_DAYS=90

# --- AI clip detection (worker) ---------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Google sign-in verification (API, optional) ----------------------------
# Either paste the full service-account JSON, or set CLIENT_EMAIL + PRIVATE_KEY.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Media toolchain (worker) -----------------------------------------------
YTDLP_BIN=yt-dlp
# Optional cookies file to avoid YouTube bot checks on servers.
YTDLP_COOKIES_FILE=
YTDLP_MAX_HEIGHT=1080
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FFMPEG_THREADS=0
WHISPER_BIN=whisper
WHISPER_MODEL=small
WHISPER_THREADS=4
PYTHON_BIN=python3
FACE_DETECTION=true
CAPTION_FONT=DejaVu Sans
WATERMARK_TEXT=ClipForge AI
MAX_VIDEO_DURATION_SECONDS=14400
JOB_CONCURRENCY=1
LOG_LEVEL=info
