# syntax=docker/dockerfile:1
# Production Cloud Run Video Processing Worker for Klipper AI
# Optimized multi-stage build with FFmpeg & TrueType Fonts for subtitle rendering

FROM node:22-bookworm-slim AS base
WORKDIR /app

# Install system dependencies: FFmpeg, fonts, ca-certificates
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    fontconfig \
    fonts-freefont-ttf \
    fonts-dejavu-core \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Verify FFmpeg installation
RUN ffmpeg -version

# Copy package descriptors
COPY package*.json ./

# Install production dependencies
RUN npm ci --only=production || npm install

# Copy application source
COPY . .

# Create storage scratch directories and set permissions
RUN mkdir -p /app/storage/temp \
    /app/storage/source \
    /app/storage/audio \
    /app/storage/clips \
    /app/storage/exports \
    /app/storage/thumbnails \
    /app/storage/preview \
    && chown -R node:node /app

USER node

ENV NODE_ENV=production
ENV PORT=8080

EXPOSE 8080

# Run worker runner with signal trap for Cloud Run SIGTERM
CMD ["npm", "run", "worker"]
